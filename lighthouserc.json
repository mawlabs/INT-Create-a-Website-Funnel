{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/(404\\.html|404/|thanks/|merci/)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "is-crawlable": "off"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(404\\.html|404/|thanks/|merci/)$).*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
