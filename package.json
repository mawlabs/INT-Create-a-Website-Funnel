{
  "name": "maw-landers",
  "private": true,
  "version": "0.1.0",
  "description": "Monkeys at Work funnel landing sites: static Astro sites sharing one kit.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './sites/*' build",
    "check": "pnpm -r --filter './sites/*' check && node scripts/check-copy.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:copy:strict": "node scripts/check-copy.mjs --strict",
    "lhci": "node scripts/lhci.mjs",
    "screens": "node scripts/screens.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test:quote": "node -e \"require('child_process').execFileSync(require('path').join(require.resolve('esbuild/package.json'),'..','bin','esbuild'),['scripts/quote-test.mjs','--bundle','--platform=node','--format=esm','--outfile=.cache/quote-test.bundle.mjs','--log-level=warning'],{stdio:'inherit'})\" && node .cache/quote-test.bundle.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "playwright-core": "^1.58.0",
    "esbuild": "^0.28.2"
  }
}
