---
/**
 * "Do you need us?" (brief §5.3). A real <table> on wide screens; on narrow screens each column
 * becomes a stacked block with the row labels repeated as <dt>. Not cards.
 */
import type { CompareCopy } from '../lib/copy';
import type { Locale } from '../lib/i18n';
import { renderPricing, type PricingData } from '../lib/pricing';

interface Props {
  copy: CompareCopy;
  locale: Locale;
  pricing: PricingData;
  id?: string;
}
const { copy, locale, pricing, id = 'compare' } = Astro.props;
const rows = copy.rows.map((r) => ({
  ...r,
  cells: r.cells.map((c) => renderPricing(c, pricing, locale)) as [string, string, string],
}));
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <h2 id={`${id}-h`}>{copy.h2}</h2>
    <p class="intro">{copy.intro}</p>

    <table class="data-table only-wide">
      <thead>
        <tr>
          <td></td>
          {copy.columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {r.cells.map((c) => <td class:list={[{ highlight: r.highlight }]}>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>

    <div class="stack only-narrow">
      {copy.columns.map((col, i) => (
        <section>
          <h3>{col}</h3>
          <dl>
            {rows.map((r) => (
              <>
                <dt>{r.label}</dt>
                <dd class:list={[{ highlight: r.highlight }]}>{r.cells[i]}</dd>
              </>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <div class="lists">
      <div>
        <h3>{copy.no.title}</h3>
        <ul>{copy.no.items.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div>
        <h3>{copy.yes.title}</h3>
        <ul>{copy.yes.items.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .data-table thead td { background: var(--maw-power-blue); border-color: color-mix(in srgb, #FFFFFF 25%, var(--maw-power-blue)); }
  .data-table th[scope="col"] { width: 28%; }
  .lists { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
  @media (min-width: 45em) { .lists { grid-template-columns: 1fr 1fr; } }
  .lists h3 { margin-bottom: var(--space-1); }
  .lists ul { padding-inline-start: 1.2em; }
  .lists li + li { margin-top: var(--space-1); }
</style>
