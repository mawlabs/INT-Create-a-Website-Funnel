---
/** Primary button. By default it points at the on-page quote tool; pass `href` for anything else. */
interface Props { label: string; note?: string; href: string; section: string; project?: string }
const { label, note, href, section, project } = Astro.props;
---
<p class="cta">
  <a class="btn" href={href} data-cta={section} data-project={project}>{label}</a>
  {note && <span class="btn-note">{note}</span>}
</p>
<style>.cta { max-width: none; }</style>
