---
/** Native <details>/<summary> FAQ; first item open (brief §5.7). Dotted rules, Sunset dot marker. */
import type { FaqItemCopy } from '../lib/copy';
interface Props { h2: string; items: { q: string; a: string }[] | FaqItemCopy[]; id?: string; guide?: { href: string; label: string } }
const { h2, items, id = 'faq', guide } = Astro.props;
function split(a: string): { before: string; after: string | null } {
  const i = a.indexOf('{guideLink}');
  return i === -1 ? { before: a, after: null } : { before: a.slice(0, i), after: a.slice(i + '{guideLink}'.length) };
}
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap wrap-narrow">
    <h2 id={`${id}-h`} class="dot">{h2}</h2>
    <div class="faq">
      {items.map((it, i) => {
        const parts = split(it.a);
        return (
          <details open={i === 0}>
            <summary><span>{it.q}</span><span class="marker" aria-hidden="true"></span></summary>
            <p>{parts.before}{parts.after !== null && guide && <a href={guide.href}><em>{guide.label}</em></a>}{parts.after}</p>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
  .faq { border-top: 1px solid var(--color-rule); margin-top: var(--space-3); }
  details { border-bottom: 1px solid var(--color-rule); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); cursor: pointer; list-style: none; padding: 0.875rem 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.06rem, 2vw, 1.25rem); max-width: none; }
  summary::-webkit-details-marker { display: none; }
  .marker { width: 11px; height: 11px; border-radius: 50%; background: var(--color-accent); flex: none; transition: transform 150ms ease; }
  details[open] .marker { transform: scale(1.35); }
  details p { padding-bottom: var(--space-3); max-width: 40rem; }
</style>
