---
/**
 * HTML shell shared by every page: head (Seo, fonts, styles), skip link, LangBar, Header, main, Footer, ConsentBanner.
 */
import '../styles/base.css';
import satoshiUrl from '../fonts/Satoshi-Bold.woff2?url';
import plexUrl from '../fonts/IBMPlexSans-Regular.woff2?url';
import type { ChromeCopy, LangBarCopy } from '../lib/copy';
import { LANG_TAG, type Locale } from '../lib/i18n';
import type { PageMeta } from '../lib/seo';
import ConsentBanner from './ConsentBanner.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import JsonLd from './JsonLd.astro';
import LangBar from './LangBar.astro';
import Seo from './Seo.astro';

interface Props {
  locale: Locale;
  meta: PageMeta;
  chrome: ChromeCopy;
  /** LangBar copy written in the OTHER language (the one it offers). */
  langBar: LangBarCopy;
  site: { origin: string; ga4Id: string; gscVerification: string };
  paths: { home: string; privacy: string };
  jsonLd?: Record<string, unknown>;
  /** Sets <body data-event>, read by the analytics island (thanks page → form_submit). */
  bodyEvent?: string;
}
const { locale, meta, chrome, langBar, site, paths, jsonLd, bodyEvent } = Astro.props;
const other: Locale = locale === 'en' ? 'fr' : 'en';
---
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={meta} origin={site.origin} siteName={chrome.siteName} gscVerification={site.gscVerification} />
    <link rel="preload" href={satoshiUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F7FBFE" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body data-event={bodyEvent}>
    <a class="skip-link" href="#main">{chrome.skipLink}</a>
    <LangBar copy={langBar} locale={locale} otherPath={meta.alternates[other]} />
    <Header copy={chrome.header} siteName={chrome.siteName} locale={locale} homePath={paths.home} alternates={meta.alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer copy={chrome.footer} locale={locale} privacyPath={paths.privacy} alternates={meta.alternates} langLabels={{ en: chrome.header.en, fr: chrome.header.fr }} />
    <ConsentBanner copy={chrome.consent} locale={locale} privacyPath={paths.privacy} measurementId={site.ga4Id} />
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
