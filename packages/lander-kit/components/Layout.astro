---
/** HTML shell shared by every page: head (Seo, fonts, styles), skip link, LangBar, Header, main, Footer, ConsentBanner. */
import '../styles/base.css';
import satoshiBlackUrl from '../fonts/Satoshi-Black.woff2?url';
import plexUrl from '../fonts/IBMPlexSans-Regular.woff2?url';
import type { ChromeCopy, LangBarCopy } from '../lib/copy';
import { LANG_TAG, type Locale } from '../lib/i18n';
import type { PageMeta } from '../lib/seo';
import ConsentBanner from './ConsentBanner.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import JsonLd from './JsonLd.astro';
import LangBar from './LangBar.astro';
import Seo from './Seo.astro';

interface Props {
  locale: Locale;
  meta: PageMeta;
  chrome: ChromeCopy;
  langBar: LangBarCopy;
  site: { origin: string; ga4Id: string; gscVerification: string; bookUrl: string; mawUrl: string };
  paths: { home: string; privacy: string; guide: string };
  jsonLd?: Record<string, unknown>;
  bodyEvent?: string;
  /** Adds a class to <body>, e.g. "inverted" for the 404. */
  bodyClass?: string;
}
const { locale, meta, chrome, langBar, site, paths, jsonLd, bodyEvent, bodyClass } = Astro.props;
const other: Locale = locale === 'en' ? 'fr' : 'en';
---
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={meta} origin={site.origin} siteName={chrome.siteName} gscVerification={site.gscVerification} />
    <link rel="preload" href={satoshiBlackUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF4EA" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      /* Decide the language bar before the first paint. Adding it afterwards pushes the whole page down. */
      (function () {
        try {
          var root = document.documentElement;
          var other = root.lang.slice(0, 2) === 'fr' ? 'en' : 'fr';
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          var preferred = (langs[0] || '').toLowerCase().slice(0, 2);
          if (preferred === other && localStorage.getItem('maw-langbar-dismissed') !== '1') {
            root.setAttribute('data-langbar', 'show');
          }
        } catch (e) { /* private mode, or storage blocked: no bar */ }
      })();
    </script>
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body data-event={bodyEvent} class={bodyClass}>
    <a class="skip-link" href="#main">{chrome.skipLink}</a>
    <LangBar copy={langBar} locale={locale} otherPath={meta.alternates[other]} />
    <Header copy={chrome.header} siteName={chrome.siteName} locale={locale} homePath={paths.home} guidePath={paths.guide} bookUrl={site.bookUrl} alternates={meta.alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer copy={chrome.footer} locale={locale} privacyPath={paths.privacy} guidePath={paths.guide} bookUrl={site.bookUrl} alternates={meta.alternates} langLabels={{ en: chrome.header.en, fr: chrome.header.fr }} mawUrl={site.mawUrl} />
    <ConsentBanner copy={chrome.consent} locale={locale} privacyPath={paths.privacy} measurementId={site.ga4Id} />
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  body.inverted { background: var(--color-dark); color: var(--color-ink-on-dark); }
</style>
