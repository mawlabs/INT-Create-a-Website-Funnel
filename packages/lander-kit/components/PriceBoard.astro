---
/**
 * "What things cost" — the price board (brief §5.4, Menu du jour). Charcoal full-bleed with awning stripes;
 * every price is a dot-leader line: name → leader → range. Numbers from pricing.ts, labels from copy.
 */
import type { BoardCopy } from '../lib/copy';
import type { Locale } from '../lib/i18n';
import { formatPriceRange, renderPricing, type PricingData } from '../lib/pricing';
import LeaderLine from './LeaderLine.astro';

interface Props { copy: BoardCopy; locale: Locale; pricing: PricingData; ctaHref: string; id?: string }
const { copy, locale, pricing, ctaHref, id = 'prices' } = Astro.props;
const groups = pricing.groups.map((g) => {
  const gc = copy.groups[g.id];
  if (!gc) throw new Error(`board copy missing for group "${g.id}" (${locale})`);
  return {
    id: g.id,
    title: renderPricing(gc.title, pricing, locale),
    lines: g.tiers.map((t) => {
      const name = gc.tiers[t.id];
      if (!name) throw new Error(`board copy missing for tier "${g.id}.${t.id}" (${locale})`);
      const price = t.price ? `${formatPriceRange(t.price, locale)}${gc.suffix ? ` ${gc.suffix}` : ''}` : copy.quotedLater;
      return { name, price, quoted: !t.price };
    }),
  };
});
---
<section class="board on-dark" id={id} aria-labelledby={`${id}-h`}>
  <div class="awning" aria-hidden="true"></div>
  <div class="wrap wrap-narrow inner">
    <h2 id={`${id}-h`} class="dot">{copy.h2.replace(/\.$/, '')}</h2>
    <p class="intro">{renderPricing(copy.intro, pricing, locale)}</p>
    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3 class="meta on-dark group-title">— {g.title} —</h3>
          {g.lines.map((l) => <LeaderLine label={l.name} value={l.price} class:list={[{ quoted: l.quoted }]} />)}
        </div>
      ))}
    </div>
    <p class="line">{copy.line}</p>
    <p class="cta"><a class="btn" href={ctaHref} data-cta="pricing">{copy.cta}</a></p>
  </div>
  <div class="awning" aria-hidden="true"></div>
</section>

<style>
  .board { position: relative; }
  .inner { position: relative; padding-block: var(--section-pad); text-align: start; }
  .intro { margin-top: var(--space-2); color: var(--color-meta-on-dark); max-width: var(--measure); }
  .groups { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
  .group { display: grid; gap: 0.8rem; }
  .group-title { font-size: var(--step-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-leader); margin-bottom: 0.25rem; }
  .group :global(.leader-line .label) { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .group :global(.leader-line.quoted .value) { font-family: var(--font-mono); font-weight: 500; font-size: var(--step-mono); letter-spacing: 0.06em; color: var(--color-meta-on-dark); }
  .line { margin-top: var(--space-4); }
  .cta { margin-top: var(--space-3); max-width: none; }
</style>
