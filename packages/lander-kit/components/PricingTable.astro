---
/**
 * "What things cost" (brief §5.4). One table per group, tiers as rows: Price · Hours · What's included.
 * Numbers come from the site's pricing data; names and "what's included" come from copy.
 */
import type { PricingCopy } from '../lib/copy';
import type { Locale } from '../lib/i18n';
import { formatHoursRange, formatPriceRange, renderPricing, type PricingData } from '../lib/pricing';
import CtaLink from './CtaLink.astro';

interface Props {
  copy: PricingCopy;
  locale: Locale;
  pricing: PricingData;
  id?: string;
  source?: string;
}
const { copy, locale, pricing, id = 'pricing', source } = Astro.props;

const groups = pricing.groups.map((g) => {
  const gc = copy.groups[g.id];
  if (!gc) throw new Error(`pricing copy missing for group "${g.id}" (${locale})`);
  return {
    id: g.id,
    title: renderPricing(gc.title, pricing, locale),
    priceLabel: gc.priceLabel ?? copy.headers.price,
    tiers: g.tiers.map((t) => {
      const tc = gc.tiers[t.id];
      if (!tc) throw new Error(`pricing copy missing for tier "${g.id}.${t.id}" (${locale})`);
      return {
        id: t.id,
        name: tc.name,
        price: t.price ? formatPriceRange(t.price, locale) : null,
        hours: t.hours ? formatHoursRange(t.hours, locale) : null,
        includes: renderPricing(tc.includes, pricing, locale),
      };
    }),
  };
});
const intro = renderPricing(copy.intro, pricing, locale);
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <h2 id={`${id}-h`}>{copy.h2}</h2>
    <p class="intro">{intro}</p>

    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3 id={`${id}-${g.id}`}>{g.title}</h3>
          <table class="data-table only-wide" aria-labelledby={`${id}-${g.id}`}>
            <thead>
              <tr>
                <th scope="col">{copy.headers.tier}</th>
                <th scope="col">{g.priceLabel}</th>
                <th scope="col">{copy.headers.hours}</th>
                <th scope="col">{copy.headers.includes}</th>
              </tr>
            </thead>
            <tbody>
              {g.tiers.map((t) => (
                <tr>
                  <th scope="row">{t.name}</th>
                  {t.price
                    ? <><td>{t.price}</td><td>{t.hours}</td><td>{t.includes}</td></>
                    : <td colspan="3">{t.includes || copy.quotedLater}</td>}
                </tr>
              ))}
            </tbody>
          </table>

          <div class="stack only-narrow">
            {g.tiers.map((t) => (
              <section>
                <h4>{t.name}</h4>
                <dl>
                  {t.price ? (
                    <>
                      <dt>{g.priceLabel}</dt><dd>{t.price}</dd>
                      <dt>{copy.headers.hours}</dt><dd>{t.hours}</dd>
                      <dt>{copy.headers.includes}</dt><dd>{t.includes}</dd>
                    </>
                  ) : (
                    <>
                      <dt>{g.priceLabel}</dt><dd>{t.includes || copy.quotedLater}</dd>
                    </>
                  )}
                </dl>
              </section>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="line">{copy.line}</p>
    <CtaLink label={copy.cta} note={copy.ctaNote} locale={locale} section="pricing" source={source} />
  </div>
</section>

<style>
  .groups { display: grid; gap: var(--space-4); }
  .group h3 { margin-bottom: var(--space-2); }
  .data-table th[scope="col"]:nth-child(1) { width: 18%; }
  .data-table th[scope="col"]:nth-child(2) { width: 20%; white-space: nowrap; }
  .data-table th[scope="col"]:nth-child(3) { width: 14%; white-space: nowrap; }
  .data-table td:nth-child(2), .data-table td:nth-child(3) { white-space: nowrap; }
  .line { margin-top: var(--space-4); }
</style>
