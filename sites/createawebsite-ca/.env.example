# Public identifiers only — never secrets. SSH keys and hosts live in GitHub Actions secrets.
PUBLIC_SITE_URL=https://createawebsite.ca
PUBLIC_GA4_ID=
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_EN=
PUBLIC_HUBSPOT_FORM_FR=
PUBLIC_GSC_VERIFICATION=

# MAW lead pipeline (process-lead edge function). Leave empty to use the default project host.
PUBLIC_MAW_LEAD_ENDPOINT=

# Site audit endpoint. Defaults to the PHP file deployed with the site.
PUBLIC_AUDIT_ENDPOINT=

# Staging or demo build: noindex every page and disallow robots. Never set this for production.
PUBLIC_NOINDEX=
