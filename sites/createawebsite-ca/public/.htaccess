# createawebsite.ca — Apache rules (brief §10.4). No language redirects: EN at /, FR at /fr/, switch is a link.

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Canonical host: non-www. TODO(angelique): confirm www or not (brief §10.4).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Not found: language by path prefix
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/fr(/|$)#">
  ErrorDocument 404 /fr/404/index.html
</If>

# Caching: hashed assets are immutable, HTML is short-lived
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|llms\.txt|sitemap.*\.xml|og-.*\.png)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # The site audit endpoint answers per request and must never be cached.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
