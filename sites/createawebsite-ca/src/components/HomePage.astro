---
/** Home page, quote-first: hero with the instant-quote panel, price board, how it works, work, FAQ, question form. */
import CaseStudies from '@maw/lander-kit/components/CaseStudies.astro';
import Faq from '@maw/lander-kit/components/Faq.astro';
import Hero from '@maw/lander-kit/components/Hero.astro';
import Layout from '@maw/lander-kit/components/Layout.astro';
import LeadForm from '@maw/lander-kit/components/LeadForm.astro';
import PriceBoard from '@maw/lander-kit/components/PriceBoard.astro';
import Steps from '@maw/lander-kit/components/Steps.astro';
import type { Locale } from '@maw/lander-kit/lib/i18n';
import { renderPricing } from '@maw/lander-kit/lib/pricing';
import * as schema from '@maw/lander-kit/lib/schema';
import { pricing } from '../data/pricing';
import { caseStudies, testimonials } from '../data/work';
import { copy } from '../i18n';
import { baseNodes, layoutProps, pageMeta } from '../lib/page';
import { routes, site } from '../site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
const meta = pageMeta('home', locale, c.meta.home);
const faqItems = c.home.faq.items.map((it) => ({ q: it.q, a: renderPricing(it.a, pricing, locale) }));
const jsonLd = schema.graph([...baseNodes(locale), schema.faqPage(faqItems)]);
---
<Layout {...layoutProps(locale)} meta={meta} jsonLd={jsonLd}>
  <Hero
    copy={c.home.hero}
    quote={c.home.quote}
    locale={locale}
    pricing={pricing}
    config={{
      leadEndpoint: site.leadEndpoint,
      bookUrl: site.bookUrl,
      supportEmail: site.supportEmail,
      thanksPath: routes.thanks[locale],
      privacyPath: routes.privacy[locale],
      termsUrl: site.termsUrl,
      domain: site.domain,
    }}
  />
  <PriceBoard copy={c.home.board} locale={locale} pricing={pricing} ctaHref="#quote" />
  <Steps copy={c.home.steps} />
  <CaseStudies copy={c.home.work} items={caseStudies[locale]} quotes={testimonials[locale]} />
  <Faq h2={c.home.faq.h2} items={faqItems} />
  <LeadForm
    copy={c.home.form}
    locale={locale}
    portalId={site.hubspot.portalId}
    formGuid={locale === 'fr' ? site.hubspot.formFr : site.hubspot.formEn}
    thanksPath={routes.thanks[locale]}
    pageName={c.meta.home.title}
    supportEmail={site.supportEmail}
  />
</Layout>
